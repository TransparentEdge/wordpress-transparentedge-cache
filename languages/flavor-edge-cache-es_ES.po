#: includes/speculation/TE_Conflict_Detector.php:57
msgid "Performance Lab may include the Speculative Loading module, which outputs duplicate rules."
msgstr "Performance Lab puede incluir el módulo Speculative Loading, que emite reglas duplicadas."

#: includes/speculation/TE_Conflict_Detector.php:58
msgid "Flying Pages prefetches links on viewport with JavaScript, which can duplicate Speculation Rules requests."
msgstr "Flying Pages implementa prefetch on viewport vía JavaScript, lo que puede duplicar las peticiones de Speculation Rules."

#: includes/speculation/TE_Conflict_Detector.php:59
msgid "WP Rocket has the “Preload links” option, which duplicates prefetches."
msgstr "WP Rocket tiene la opción «Preload links», que duplica prefetches."

#: includes/speculation/TE_Conflict_Detector.php:60
msgid "Perfmatters includes instant.page, which duplicates prefetches on hover."
msgstr "Perfmatters incluye instant.page, que duplica prefetches on hover."

#: includes/speculation/TE_Conflict_Detector.php:61
msgid "NitroPack includes its own prefetch/prerender system."
msgstr "NitroPack incluye su propio sistema de prefetch/prerender."

#: includes/security/TE_Hardening.php:94
msgid "Too many failed login attempts. Please try again in a few minutes."
msgstr "Demasiados intentos de acceso fallidos. Inténtalo de nuevo en unos minutos."

#: includes/pagecache/TE_PageCache.php:120
msgid "WP_CACHE is not set in wp-config.php, so WordPress never loads the cache. Add near the top: define('WP_CACHE', true);"
msgstr "WP_CACHE no está definido en wp-config.php, así que WordPress nunca carga la caché. Añade cerca del principio: define('WP_CACHE', true);"

#: includes/pagecache/TE_PageCache.php:122
msgid "The advanced-cache.php drop-in is missing. Toggle the page cache off and on to rewrite it."
msgstr "Falta el drop-in advanced-cache.php. Desactiva y vuelve a activar la page cache para reescribirlo."

#: includes/pagecache/TE_PageCache.php:836
msgid "Another advanced-cache.php drop-in is already installed. Remove it first."
msgstr "Ya hay instalado otro drop-in advanced-cache.php. Quítalo primero."

#: includes/pagecache/TE_PageCache.php:845
msgid "Could not write advanced-cache.php. Check permissions on wp-content/."
msgstr "No se pudo escribir advanced-cache.php. Revisa los permisos de wp-content/."

#: includes/pagecache/TE_PageCache.php:856
msgid "Origin page cache enabled."
msgstr "Page cache de origen activada."

#: includes/pagecache/TE_PageCache.php:868
msgid "Origin page cache disabled."
msgstr "Page cache de origen desactivada."

#: includes/pagecache/TE_PageCache.php:909
#, php-format
msgid "Could not locate wp-config.php. Add this near the top manually: %s"
msgstr "No se ha encontrado wp-config.php. Añade esto a mano cerca del principio: %s"

#: includes/pagecache/TE_PageCache.php:921
#, php-format
msgid "Could not read wp-config.php. Add this near the top manually: %s"
msgstr "No se ha podido leer wp-config.php. Añade esto a mano cerca del principio: %s"

#: includes/pagecache/TE_PageCache.php:938
msgid "wp-config.php already sets WP_CACHE to false. Change it to true to enable the page cache."
msgstr "wp-config.php ya define WP_CACHE como false. Cámbialo a true para activar la page cache."

#: includes/pagecache/TE_PageCache.php:957
#, php-format
msgid "wp-config.php is not writable. Add this near the top manually: %s"
msgstr "wp-config.php no tiene permisos de escritura. Añade esto a mano cerca del principio: %s"

#: includes/pagecache/TE_PageCache.php:981
msgid "Could not find the <?php opening in wp-config.php. Add this near the top manually: define('WP_CACHE', true);"
msgstr "No se encontró la apertura <?php en wp-config.php. Añade esto a mano cerca del principio: define('WP_CACHE', true);"

#: includes/pagecache/TE_PageCache.php:1007
msgid "Could not update wp-config.php."
msgstr "No se pudo actualizar wp-config.php."

#: includes/pagecache/TE_PageCache.php:1091
msgid "Page cache flushed."
msgstr "Page cache vaciada."
