msgstr "Convertir automáticamente imágenes a WebP para navegadores compatibles"

#: includes/admin/views/main-page.php:732
msgid "JPEG Quality"
msgstr "Calidad JPEG"

#: includes/admin/views/main-page.php:739
msgid "WebP Quality"
msgstr "Calidad WebP"

#: includes/admin/views/main-page.php:746
