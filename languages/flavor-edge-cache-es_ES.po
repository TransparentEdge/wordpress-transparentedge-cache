msgstr ""
"Protecciones a nivel de WordPress. Disponibles para todos los clientes."

#: includes/admin/views/tab-security.php:34
msgid "Block PHP in uploads"
msgstr "Bloquear PHP en uploads"

#: includes/admin/views/tab-security.php:38
