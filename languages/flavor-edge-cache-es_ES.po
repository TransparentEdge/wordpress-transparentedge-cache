msgstr "Autenticación Redis fallida. Revisa WP_REDIS_PASSWORD en wp-config.php."

#: includes/modules/TE_ObjectCache.php:231
msgid "phpredis is installed but no Redis server answered here. Start Redis, or point WP_REDIS_HOST / WP_REDIS_PORT at a running one."
msgstr "phpredis está instalado pero ningún servidor Redis respondió aquí. Arranca Redis, o apunta WP_REDIS_HOST / WP_REDIS_PORT a uno en marcha."

#: includes/modules/TE_ObjectCache.php:270
