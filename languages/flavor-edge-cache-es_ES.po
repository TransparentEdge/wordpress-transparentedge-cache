#: includes/pagecache/TE_PageCache.php:99
msgid ""
"WP_CACHE is not set in wp-config.php, so WordPress never loads the cache. "
"Add near the top: define('WP_CACHE', true);"
msgstr ""
"WP_CACHE no está definido en wp-config.php, así que WordPress nunca carga la"
" caché. Añade cerca del principio: define('WP_CACHE', true);"

#: includes/pagecache/TE_PageCache.php:101
msgid ""
"The advanced-cache.php drop-in is missing. Toggle the page cache off and on "
"to rewrite it."
msgstr ""
"Falta el drop-in advanced-cache.php. Desactiva y vuelve a activar la page "
"cache para reescribirlo."

#: includes/pagecache/TE_PageCache.php:522
msgid ""
"Another advanced-cache.php drop-in is already installed. Remove it first."
msgstr "Ya hay instalado otro drop-in advanced-cache.php. Quítalo primero."

#: includes/pagecache/TE_PageCache.php:531
msgid "Could not write advanced-cache.php. Check permissions on wp-content/."
msgstr ""
"No se pudo escribir advanced-cache.php. Revisa los permisos de wp-content/."

#: includes/pagecache/TE_PageCache.php:542
msgid "Origin page cache enabled."
msgstr "Page cache de origen activada."

#: includes/pagecache/TE_PageCache.php:554
msgid "Origin page cache disabled."
msgstr "Page cache de origen desactivada."

#: includes/pagecache/TE_PageCache.php:595
#, php-format
msgid "wp-config.php is not writable. Add this near the top manually: %s"
msgstr ""
"wp-config.php no tiene permisos de escritura. Añade esto a mano cerca del "
"principio: %s"

#: includes/pagecache/TE_PageCache.php:610
msgid ""
"wp-config.php already sets WP_CACHE to false. Change it to true to enable "
"the page cache."
msgstr ""
"wp-config.php ya define WP_CACHE como false. Cámbialo a true para activar la"
" page cache."

#: includes/pagecache/TE_PageCache.php:634
msgid ""
"Could not find the <?php opening in wp-config.php. Add this near the top "
