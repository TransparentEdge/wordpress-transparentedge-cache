#: includes/admin/views/tab-security.php:75
msgid "X-Content-Type-Options"
msgstr "X-Content-Type-Options"

#: includes/admin/views/tab-security.php:79
msgid "X-Frame-Options"
msgstr "X-Frame-Options"

#: includes/admin/views/tab-security.php:83
msgid "Referrer-Policy"
msgstr "Referrer-Policy"

#: includes/admin/views/tab-security.php:87
msgid "Permissions-Policy"
msgstr "Permissions-Policy"

#: includes/admin/views/tab-security.php:88
msgid "Restrict geolocation, microphone, camera"
msgstr "Restringir geolocalización, micrófono, cámara"

#: includes/admin/views/tab-security.php:91
msgid "HSTS"
msgstr "HSTS"

#: includes/admin/views/tab-security.php:94
msgid ""
"Only enable if HTTPS is fully working. Requires valid certificates on all "
"subdomains."
msgstr ""
"Actívalo solo si HTTPS funciona por completo. Requiere certificados válidos "
