msgstr "Content-Security-Policy"

#: includes/admin/views/tab-security.php:102
msgid "Enable CSP"
msgstr "Activar CSP"

#: includes/admin/views/tab-security.php:106
msgid "Enforce (unchecked = Report-Only, recommended for testing first)"
msgstr "Aplicar (desmarcado = Report-Only, recomendado para probar primero)"

#: includes/admin/views/tab-security.php:111
